# =============================================================================
# VoyageMesh — example environment file
#
# Copy to `.env` and adjust. `.env` is git-ignored.
#
#   Copy-Item .env.example .env
#
# IMPORTANT: this file contains NO secret VALUES — only *paths* to secret files.
# Never put an API key, client secret, or password literal in here.
# =============================================================================

# --- Service identity -------------------------------------------------------
SERVICE_NAME=voyagemesh
SERVICE_VERSION=0.1.0
# local | test | production
ENVIRONMENT=local
LOG_LEVEL=INFO
# json | console  (use `console` for readable local development output)
LOG_FORMAT=console
HOST=0.0.0.0
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- LLM (Groq) -------------------------------------------------------------
# groq | mock
LLM_PROVIDER=groq
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_CALLS_PER_AGENT=6
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=2048

GROQ_MODEL=llama-3.3-70b-versatile
GROQ_JUDGE_MODEL=llama-3.1-8b-instant
# Host path (Windows). Inside Docker this is overridden to /run/secrets/groq_api_key.
GROQ_API_KEY_FILE=C:\job\AI Agents Own\Voyagemesh\apikeys\api.key

# --- Authentication (Keycloak) ---------------------------------------------
AUTH_ISSUER=http://localhost:8080/realms/voyagemesh
AUTH_AUDIENCE=voyagemesh-api
AUTH_ALGORITHMS=RS256
AUTH_JWKS_CACHE_SECONDS=300
AUTH_SERVICE_CLIENT_ID=voyagemesh-orchestrator
# AUTH_SERVICE_CLIENT_SECRET_FILE=C:\job\AI Agents Own\Voyagemesh\apikeys\service.secret

# DEVELOPMENT ONLY. Accepts unauthenticated requests. Rejected when
# ENVIRONMENT=production. Leave false unless you are running without Keycloak.
AUTH_DEV_INSECURE_ALLOW_UNAUTHENTICATED=false

# --- PostgreSQL -------------------------------------------------------------
DB_URL=postgresql+asyncpg://voyagemesh:voyagemesh@localhost:5432/voyagemesh
DB_ENABLED=true
DB_POOL_SIZE=5
DB_STATEMENT_TIMEOUT_MS=10000
DB_EMBEDDING_DIMENSIONS=384

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
REDIS_KEY_PREFIX=vm

CACHE_TTL_TRANSPORT_SECONDS=900
CACHE_TTL_ACCOMMODATION_SECONDS=900
CACHE_TTL_WEATHER_SECONDS=7200
CACHE_TTL_POI_SECONDS=259200
CACHE_TTL_PLAN_SECONDS=900

# --- A2A: specialist agent endpoints ---------------------------------------
A2A_TRANSPORT_AGENT_URL=http://localhost:8010
A2A_STAY_AGENT_URL=http://localhost:8020
A2A_ITINERARY_AGENT_URL=http://localhost:8030
A2A_TIMEOUT_SECONDS=20
A2A_MAX_RETRIES=2

# --- MCP: per-agent tool servers -------------------------------------------
MCP_TRANSPORT_URL=http://localhost:8110
MCP_LODGING_URL=http://localhost:8120
MCP_DESTINATION_URL=http://localhost:8130
MCP_TIMEOUT_SECONDS=10
MCP_MAX_RETRIES=2
MCP_MAX_TOOL_CALLS_PER_TASK=8

# --- External travel data providers ----------------------------------------
# mock = offline demo; live/auto = external APIs, unavailable when keys/data are missing.
PROVIDER_MODE=mock
PROVIDER_HTTP_TIMEOUT_SECONDS=8
PROVIDER_SEARCH_TIMEOUT_SECONDS=6
# SSRF allowlist — outbound requests to any other host are refused.
PROVIDER_ALLOWED_HOSTS=api.open-meteo.com,geocoding-api.open-meteo.com,api.duffel.com,api.liteapi.travel,api.geoapify.com
# Direct Python runs: uncomment paths for the keys you have. Docker uses docker-compose.live.yml.
# PROVIDER_DUFFEL_API_KEY_FILE=apikeys/duffel/api.key
# PROVIDER_LITEAPI_API_KEY_FILE=apikeys/liteapi/api.key
# PROVIDER_GEOAPIFY_API_KEY_FILE=apikeys/geoapify/api.key
# No Omio endpoint is configured: partner API documentation is still needed.

# --- Stopping conditions / limits ------------------------------------------
LIMIT_MAX_REPLANS=3
LIMIT_MAX_TOOL_CALLS_PER_AGENT=8
LIMIT_MAX_REQUEST_DURATION_SECONDS=45
LIMIT_MAX_AGENT_TASK_DURATION_SECONDS=25
LIMIT_RATE_LIMIT_REQUESTS_PER_MINUTE=30

# --- Resilience -------------------------------------------------------------
RESILIENCE_BREAKER_FAILURE_THRESHOLD=5
RESILIENCE_BREAKER_RESET_TIMEOUT_SECONDS=30
RESILIENCE_BULKHEAD_MAX_CONCURRENCY=16

# --- Guardrails -------------------------------------------------------------
GUARDRAIL_ENABLE_INPUT_GUARDRAILS=true
GUARDRAIL_ENABLE_OUTPUT_GUARDRAILS=true
GUARDRAIL_ENABLE_PROMPT_INJECTION_DETECTION=true
GUARDRAIL_BUDGET_TOLERANCE_RATIO=0.0

# --- Observability ----------------------------------------------------------
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SAMPLER_RATIO=1.0
OTEL_CONSOLE_EXPORT=false
