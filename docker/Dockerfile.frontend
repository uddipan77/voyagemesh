# The React frontend: build the static bundle with Node, serve it with nginx. The runtime image
# carries no Node, no source, and no secret — just the compiled assets behind a tiny web server
# that also reverse-proxies /api to the gateway.
#
# syntax=docker/dockerfile:1

FROM node:22-slim AS builder
WORKDIR /app
# Install deps against the lockfile first for layer caching.
COPY apps/frontend/package.json apps/frontend/package-lock.json ./
RUN npm ci
COPY apps/frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine AS runtime
# Drop the default site; add ours (SPA fallback + /api proxy).
RUN rm /etc/nginx/conf.d/default.conf
COPY docker/nginx.conf /etc/nginx/conf.d/voyagemesh.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 3000
# nginx's own process runs as an unprivileged worker; the master needs root only to bind :3000,
# which we keep as an unprivileged high port.
HEALTHCHECK --interval=15s --timeout=3s --retries=5 \
    CMD wget -qO- http://127.0.0.1:3000/ >/dev/null 2>&1 || exit 1
