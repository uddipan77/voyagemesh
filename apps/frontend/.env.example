# Copy to .env.local and adjust for your environment. Never commit real secrets — this is a
# public client (PKCE), so it holds no client secret, but keep .env.local out of Git anyway.

# Where the API gateway lives. In dev, Vite proxies /api here (see vite.config.ts), so the
# browser can leave this at the default and make same-origin calls.
VITE_API_BASE_URL=http://localhost:8000

# Authentication mode:
#   oidc   — real Keycloak login (Authorization Code + PKCE). The default.
#   bypass — skip Keycloak entirely and rely on the gateway's dev bypass. Local dev only;
#            the gateway refuses the bypass when ENVIRONMENT=production.
VITE_AUTH_MODE=oidc

# Keycloak (public client). Only used when VITE_AUTH_MODE=oidc.
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/voyagemesh
VITE_OIDC_CLIENT_ID=voyagemesh-frontend
VITE_OIDC_REDIRECT_URI=http://localhost:3000/
